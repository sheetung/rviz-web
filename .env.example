# RViz Web Visualization 环境配置示例
# 常规部署通常只需要检查下面的“基础配置”，其余高级项可保持默认值。

# ==================== 基础配置 ====================

# ROS 环境 setup.bash 路径列表，按顺序 source，空格分隔（路径不能含空格）
# 根据 ROS_WS_URL 的版本后缀选择对应路径，默认 ROS2；不要配置 ROS_VERSION
# 每组第一个为 ROS 安装环境，后续为同版本工作空间；ROS1 路径请按实际安装修改
ROS1_SETUP_PATHS="/opt/ros/noetic/setup.bash"
ROS2_SETUP_PATHS="/opt/ros/humble/setup.bash"

# ROS1 专用：Master 地址和运行后端机器的可达 IP；ROS2 模式不使用
ROS_MASTER_URI=http://127.0.0.1:11311
ROS_IP=

# 本机 Master 不可达时自动启动；仅允许回环地址，随应用退出关闭
ROS1_AUTOSTART_MASTER=false

# ROS2 通信域 ID；只有相同 Domain ID 的 ROS2 节点才能互相发现
ROS_DOMAIN_ID=0

# 应用对外监听地址；局域网访问设为 0.0.0.0
APP_HOST=127.0.0.1

# 浏览器访问应用的端口；API 和 WebSocket 都自动使用同一地址
APP_PORT=3000

# 浏览器 ROS WebSocket 地址，默认同源 /ws/ros2；切换 ROS1 改为 /ws/ros1
# HTTP API 随该地址选择同一后端；启动时加载对应 ROS 环境，不改变本地监听
# 相对路径自动使用当前页面的主机和端口；也可填写 ws://192.168.1.10:3000/ws/ros2
# HTTPS 页面使用 wss://；留空使用同源 /ws，无版本后缀时加载 ROS2 环境
ROS_WS_URL=/ws/ros2

# ==================== 高级配置 ====================

# 开发模式文件监听器不足时使用轮询；正常启动模式不使用
CHOKIDAR_USEPOLLING=true

# 开发模式前端文件轮询间隔，单位为毫秒
CHOKIDAR_INTERVAL=500

# 启动时默认加载的 .rvizweb 配置文件名
RVIZWEB_CONFIG=default.rvizweb

# 浏览器标签页和页面左上角显示的应用标题
VITE_APP_TITLE=RVizWeb

# 是否启用后端调试模式
DEBUG=false

# 是否记录启动及运行日志；开启后每次启动生成一个按时间命名的日志目录
LOG_ENABLED=false

# ROS 订阅和发布权限边界；支持 glob，多个值用英文逗号分隔
ROS_SUBSCRIBE_TOPIC_ALLOWLIST=*
ROS_PUBLISH_TOPIC_ALLOWLIST=/goal_pose,/initialpose,/cmd_vel

# Node 固定版本下载源，空格分隔；失败时依次尝试，全部使用 HTTPS
# 自动追加版本和文件名，每个源的下载包都经过 SHA-256 校验
NODE_DOWNLOAD_URLS="https://mirrors.tuna.tsinghua.edu.cn/nodejs-release https://npmmirror.com/mirrors/node https://nodejs.org/dist"

# npm 依赖仓库（与 Node 安装包下载源不同）；只对本项目脚本生效
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
