<?xml version="1.0" encoding="UTF-8"?>
<!-- Benchmark-only, same-host DDS. No UDP transport or external discovery. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>benchmark_shm</transport_id>
      <type>SHM</type>
      <segment_size>67108864</segment_size>
      <maxMessageSize>20000000</maxMessageSize>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="benchmark_local" is_default_profile="true">
    <rtps>
      <userTransports><transport_id>benchmark_shm</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
